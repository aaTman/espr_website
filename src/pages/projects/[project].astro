---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsDashboard from '../../components/ProjectsDashboard.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { project: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<BaseLayout title={`${project.name} — espr.ai`} description={project.blurb} current="projects">
  <ProjectsDashboard project={project} />
</BaseLayout>

---
interface Props {
  overlay?: boolean;      // true on the landing page (nav floats over the hero)
  current?: string;       // 'projects' | 'writing' | 'about'
}
const { overlay = false, current } = Astro.props;
---
<nav class:list={['site-nav', { solid: !overlay }]}>
  <div class="wrap nav-inner">
    <a class="home" href="/">Taylor Mandelbaum</a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-menu"
      aria-label="Toggle navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="nav-links" id="site-nav-menu">
      <a href="/projects/" aria-current={current === 'projects' ? 'page' : undefined}>Projects</a>
      <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
      <a href="/blog/" aria-current={current === 'writing' ? 'page' : undefined}>Writing</a>
      <a href="/resume/" aria-current={current === 'resume' ? 'page' : undefined}>Resume/CV</a>
    </div>
  </div>
</nav>

<script>
  // Delegated on document/window (registered once) rather than bound to specific
  // nav elements, because Astro's view-transition navigation swaps the nav's DOM
  // and this module script does not re-run on subsequent navigations.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    document.querySelectorAll('.site-nav').forEach((nav) => {
      const toggle = nav.querySelector('.nav-toggle');
      const menu = nav.querySelector('.nav-links');

      if (toggle && target === toggle) {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        menu?.classList.toggle('is-open', !isOpen);
        return;
      }

      if (toggle && menu) {
        const clickedMenuLink = menu.contains(target) && target.closest('a');
        if (!nav.contains(target) || clickedMenuLink) {
          toggle.setAttribute('aria-expanded', 'false');
          menu.classList.remove('is-open');
        }
      }
    });
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 760) {
      document.querySelectorAll('.site-nav .nav-toggle').forEach((toggle) => {
        toggle.setAttribute('aria-expanded', 'false');
      });
      document.querySelectorAll('.site-nav .nav-links').forEach((menu) => {
        menu.classList.remove('is-open');
      });
    }
  });
</script>

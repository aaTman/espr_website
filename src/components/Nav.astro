---
interface Props {
  overlay?: boolean;      // true on the landing page (nav floats over the hero)
  current?: string;       // 'work' | 'writing' | 'about'
}
const { overlay = false, current } = Astro.props;
---
<nav class:list={['site-nav', { solid: !overlay }]}>
  <div class="wrap nav-inner">
    <a class="home" href="/">Taylor Mandelbaum</a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-menu"
      aria-label="Toggle navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="nav-links" id="site-nav-menu">
      <div class="nav-dropdown">
        <button
          class="nav-dropdown-toggle"
          type="button"
          aria-expanded="false"
          aria-current={current === 'fronts' ? 'page' : undefined}
        >
          Projects
        </button>
        <div class="nav-dropdown-menu">
          <a href="https://fronts.espr.ai" aria-current={current === 'fronts' ? 'page' : undefined}>Fronts</a>
        </div>
      </div>
      <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
      <a href="/blog/" aria-current={current === 'writing' ? 'page' : undefined}>Writing</a>
      <a href="/resume/" aria-current={current === 'resume' ? 'page' : undefined}>Resume/CV</a>
    </div>
  </div>
</nav>

<script>
  const navs = document.querySelectorAll('.site-nav');

  navs.forEach((nav) => {
    const toggle = nav.querySelector('.nav-toggle');
    const menu = nav.querySelector('.nav-links');

    if (!toggle || !menu) return;

    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        closeMenu();
      } else {
        toggle.setAttribute('aria-expanded', 'true');
        menu.classList.add('is-open');
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!nav.contains(target)) closeMenu();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 760) closeMenu();
    });

    const dropdown = nav.querySelector('.nav-dropdown');
    const dropdownToggle = nav.querySelector('.nav-dropdown-toggle');

    if (dropdown && dropdownToggle) {
      const closeDropdown = () => {
        dropdownToggle.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('is-open');
      };

      dropdownToggle.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = dropdownToggle.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          closeDropdown();
        } else {
          dropdownToggle.setAttribute('aria-expanded', 'true');
          dropdown.classList.add('is-open');
        }
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!dropdown.contains(target)) closeDropdown();
      });
    }
  });
</script>
